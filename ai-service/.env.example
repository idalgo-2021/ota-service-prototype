# Application
APP_ENV=development
LOG_LEVEL=INFO

# AI service PostgreSQL connection
AI_DB_HOST=localhost
AI_DB_PORT=55432
AI_DB_NAME=ai_service
AI_DB_USER=ai_service
AI_DB_PASSWORD=change-me

# PostgreSQL initialization for Docker Compose
POSTGRES_USER=ai_service
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_service

# AI service access to the OTA API
OTA_API_BASE_URL=http://localhost:8080
OTA_AI_EMAIL=ai-robot@example.invalid
OTA_AI_PASSWORD=change-me

# Shared key for internal requests between OTA and the AI service
AI_INTERNAL_API_KEY=change-me-ai-internal-key

# Assistant model configuration
ASSISTANT_LLM_MODEL_ID=openai/gpt-4o-mini
ASSISTANT_LLM_API_BASE=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_TEMPERATURE=0.2
ASSISTANT_AGENT_LOG_LEVEL=ERROR

# Review summarizer model configuration
REVIEW_SUMMARY_LLM_MODEL_ID=openai/gpt-4o-mini
REVIEW_SUMMARY_LLM_API_BASE=
REVIEW_SUMMARY_LLM_API_KEY=
REVIEW_SUMMARY_LLM_TEMPERATURE=0.2

# Rating and recommendation thresholds for the disappointment detector
DISAPPOINTMENT_MIN_RATING_COUNT=5
DISAPPOINTMENT_LOW_OVERALL_RATING=7.0
DISAPPOINTMENT_CRITICAL_OVERALL_RATING=6.0
DISAPPOINTMENT_LOW_DIMENSION_RATING=6.0
DISAPPOINTMENT_DIMENSION_GAP=2.0
DISAPPOINTMENT_RECOMMENDATION_OVERALL_RATING=8.4

# Text assistant limits
CHAT_MAX_STEPS=12
CHAT_MAX_HISTORY_MESSAGES=12

# Review synchronization and summary generation
REVIEW_SUMMARY_MIN_REVIEWS=1
