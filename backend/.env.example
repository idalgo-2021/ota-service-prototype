# -- Server Configuration
HTTP_SERVER_PORT=8080

# -- HTTP Server Timeouts (in seconds)
# HTTP_READ_TIMEOUT_SECONDS=15
# HTTP_WRITE_TIMEOUT_SECONDS=120
# HTTP_IDLE_TIMEOUT_SECONDS=60

# -- Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# -- Database Pool Configuration
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_IDLE_TIME_MINUTES=30
# DB_MAX_CONN_LIFETIME_MINUTES=60

# -- JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_HOURS=168

# -- Business lifetimes (in hours)
# PENDING_ORDER_LIFETIME_HOURS=24
# REVIEW_DRAFT_LIFETIME_HOURS=168

# -- List Configuration
DEFAULT_LIST_LIMIT=20
MAX_LIST_LIMIT=100
MAX_SEARCH_RADIUS_M=5000

# -- Logging
LOG_LEVEL=info
BASE_CURRENCY=RUB

# AI service internal authentication
AI_SERVICE_BASE_URL=http://localhost:8090
AI_INTERNAL_API_KEY=change-me-ai-internal-key

